#/usr/bin/hl
using <gen 2>

// grep
// sed
// gawk

;; ── Gotowe wzorce ERE ─────────────────────────────────────────────────────────
% REGEX_DIGITS     = [0-9]+
% REGEX_INT        = ^-?[0-9]+$
% REGEX_FLOAT      = ^-?[0-9]+\.[0-9]+$
% REGEX_ALPHA      = [A-Za-z]+
% REGEX_ALNUM      = [A-Za-z0-9]+
% REGEX_WORD       = [A-Za-z0-9_]+
% REGEX_WHITESPACE = [[:space:]]+
% REGEX_EMAIL      = [A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}
% REGEX_URL        = https?://[A-Za-z0-9.-]+(:[0-9]+)?(/[^[:space:]]*)?
% REGEX_IPV4       = ([0-9]{1,3}\.){3}[0-9]{1,3}
% REGEX_MAC_ADDR   = ([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}
% REGEX_UUID       = [0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}
% REGEX_DATE_ISO   = [0-9]{4}-[0-9]{2}-[0-9]{2}
% REGEX_TIME_24H   = ([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?
% REGEX_HEX_COLOR  = #[0-9A-Fa-f]{6}\b
% REGEX_SLUG       = ^[a-z0-9]+(-[a-z0-9]+)*$

;; ═══════════════════════════════════════════════════════════════════════════════
;; DOPASOWANIE (boolean)
;; ═══════════════════════════════════════════════════════════════════════════════

: regex_match def
    ;; Uzycie: % _regex_str = tekst && % _regex_pattern = wzorzec && -- regex_match
    ;; -> exit 0 jesli wzorzec wystepuje gdziekolwiek w tekscie, inaczej exit 1
    >> printf '%s' '@_regex_str' | grep -qE '@_regex_pattern'
done

: regex_match_i def
    ;; Jak regex_match, ale bez rozroznienia wielkosci liter
    >> printf '%s' '@_regex_str' | grep -qiE '@_regex_pattern'
done

: regex_full_match def
    ;; Caly tekst musi w calosci pasowac do wzorca (wzorzec jest kotwiczony ^...$)
    >> printf '%s' '@_regex_str' | grep -qE '^(@_regex_pattern)$'
done

: regex_starts_with def
    ;; Uzycie: % _regex_str && % _regex_pattern && -- regex_starts_with
    >> printf '%s' '@_regex_str' | grep -qE '^(@_regex_pattern)'
done

: regex_ends_with def
    ;; Uzycie: % _regex_str && % _regex_pattern && -- regex_ends_with
    >> printf '%s' '@_regex_str' | grep -qE '(@_regex_pattern)$'
done

: regex_valid def
    ;; Sprawdza, czy @_regex_pattern jest poprawnym ERE (bez wykonywania dopasowania)
    ;; -> exit 0 = poprawny, exit 1 = blad skladni
    >> echo x | grep -E '@_regex_pattern' >/dev/null 2>&1; ec=$?; test "$ec" != "2"
done

;; ═══════════════════════════════════════════════════════════════════════════════
;; WYSZUKIWANIE
;; ═══════════════════════════════════════════════════════════════════════════════

: regex_find def
    ;; Uzycie: % _regex_str && % _regex_pattern && -- regex_find → @_regex_result
    ;; Pierwsze dopasowanie (puste jesli brak)
    >> printf '%s' '@_regex_str' | grep -oE '@_regex_pattern' | head -n1 |> @_regex_result
done

: regex_find_all def
    ;; Uzycie: % _regex_str && % _regex_pattern && -- regex_find_all → @_regex_result
    ;; Wszystkie dopasowania, po jednym w linii (wielolinijkowy wynik)
    >> printf '%s' '@_regex_str' | grep -oE '@_regex_pattern' |> @_regex_result
done

: regex_count def
    ;; Uzycie: % _regex_str && % _regex_pattern && -- regex_count → @_regex_count
    >> printf '%s' '@_regex_str' | grep -oE '@_regex_pattern' | wc -l | tr -d ' ' |> @_regex_count
done

;; ═══════════════════════════════════════════════════════════════════════════════
;; ZAMIANA
;; ═══════════════════════════════════════════════════════════════════════════════

: regex_replace def
    ;; Uzycie: % _regex_str && % _regex_pattern && % _regex_replacement && -- regex_replace → @_regex_result
    ;; Podmienia TYLKO pierwsze dopasowanie. W @_regex_replacement mozna uzyc \1 \2...
    ;; do wstawienia grup przechwyconych we wzorcu, oraz & = cale dopasowanie.
    >> printf '%s' '@_regex_str' | sed -E '0,/@_regex_pattern/{s//@_regex_replacement/}' |> @_regex_result
done

: regex_replace_all def
    ;; Jak regex_replace, ale podmienia WSZYSTKIE dopasowania (odpowiednik s///g)
    >> printf '%s' '@_regex_str' | sed -E 's/@_regex_pattern/@_regex_replacement/g' |> @_regex_result
done

;; ═══════════════════════════════════════════════════════════════════════════════
;; GRUPY PRZECHWYTUJACE
;; ═══════════════════════════════════════════════════════════════════════════════

: regex_extract def
    ;; Uzycie: % _regex_str && % _regex_pattern (z DOKLADNIE jedna grupa (...)) && -- regex_extract → @_regex_result
    ;; Zwraca zawartosc grupy 1. Jesli wzorzec nie pasuje, zwraca caly @_regex_str bez zmian
    ;; (ograniczenie sed) — sprawdz najpierw regex_match, jesli to istotne.
    >> printf '%s' '@_regex_str' | sed -E 's/.*@_regex_pattern.*/\1/' |> @_regex_result
done

: regex_extract_group def
    ;; Jak regex_extract, ale z wyborem numeru grupy: % _regex_group = 1..9
    >> printf '%s' '@_regex_str' | sed -E 's/.*@_regex_pattern.*/\@_regex_group/' |> @_regex_result
done

;; ═══════════════════════════════════════════════════════════════════════════════
;; PODZIAL
;; ═══════════════════════════════════════════════════════════════════════════════

: regex_split def
    ;; Uzycie: % _regex_str && % _regex_pattern (separator jako ERE) && -- regex_split → @_regex_result
    ;; Wynik wielolinijkowy, puste fragmenty (np. z podwojnych separatorow) sa pomijane
    >> printf '%s' '@_regex_str' | gawk -v RS='@_regex_pattern' '{if ($0 != "") print}' |> @_regex_result
done

;; ═══════════════════════════════════════════════════════════════════════════════
;; NARZEDZIA
;; ═══════════════════════════════════════════════════════════════════════════════

: regex_escape def
    ;; Uzycie: % _regex_str = dowolny tekst && -- regex_escape → @_regex_result
    ;; Ucieka wszystkie metaznaki ERE ( . ^ $ * + ? ( ) { } | [ ] \ ), tak by
    ;; wynik mozna bylo bezpiecznie wstawic jako literalny fragment wzorca
    ;; (przydatne, gdy wzorzec buduje sie z danych wejscia uzytkownika).
    >> printf '%s' '@_regex_str' | sed -E 's/([]\.^$*+?(){}|[\\])/\\\1/g' |> @_regex_result
done

;; ═══════════════════════════════════════════════════════════════════════════════
;; PLIKI (integruje sie z main/fs.hl)
;; ═══════════════════════════════════════════════════════════════════════════════

: regex_grep_file def
    ;; Uzycie: % _regex_file = sciezka && % _regex_pattern && -- regex_grep_file → @_regex_result
    ;; Zwraca linie pliku pasujace do wzorca (wielolinijkowy wynik)
    >> grep -oE '@_regex_pattern' '@_regex_file' |> @_regex_result
done

: regex_count_in_file def
    ;; Uzycie: % _regex_file && % _regex_pattern && -- regex_count_in_file → @_regex_count
    ;; Uwaga: jesli plik nie istnieje, grep zwroci pusty wynik zamiast "0"
    >> grep -cE '@_regex_pattern' '@_regex_file' 2> /dev/null |> @_regex_count
done
